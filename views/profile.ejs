<%- include('partials/head', { title, locale: profileUser.locale || locale, isRtl: (profileUser.locale || locale) === 'ar', t, locales, flash }) %>
<%
  const theme = profileUser.profileTheme;
  const fontClass = theme.typography === 'serif' ? 'font-serif' : theme.typography === 'mono' ? 'font-mono' : 'font-sans';
  const bgType = theme.backgroundType;
  const bgValue = theme.backgroundValue;
  const buttonClass = `bio-button-${theme.buttonStyle}`;
  const initials = profileUser.name.split(' ').map((part) => part[0]).slice(0, 2).join('').toUpperCase();
%>
<% if (theme.colorMode !== 'system') { %>
  <script>
    document.documentElement.classList.toggle('dark', '<%= theme.colorMode %>' === 'dark');
  </script>
<% } %>
<main class="profile-background relative min-h-screen overflow-hidden <%= fontClass %>" style="<%= bgType === 'gradient' || bgType === 'solid' ? `background:${bgValue};` : '' %>; --accent:<%= theme.accentColor %>;">
  <% if (bgType === 'image') { %>
    <div class="absolute inset-0 -z-10 bg-cover bg-center" style="background-image:url('<%= bgValue %>')"></div>
  <% } %>
  <% if (bgType === 'video') { %>
    <video class="absolute inset-0 -z-10 h-full w-full object-cover" src="<%= bgValue %>" autoplay muted loop playsinline></video>
  <% } %>
  <div class="absolute inset-0 -z-10 bg-white/42 backdrop-blur-[2px] dark:bg-black/54"></div>
  <div class="mx-auto flex min-h-screen w-full max-w-xl flex-col px-5 py-8">
    <section data-tilt class="glass-card rounded-[2.5rem] p-6 text-center">
      <div class="mx-auto flex h-28 w-28 items-center justify-center overflow-hidden rounded-full border border-white/60 bg-slate-950 text-3xl font-black text-white shadow-premium dark:border-white/10">
        <% if (profileUser.avatarUrl) { %>
          <img src="<%= profileUser.avatarUrl %>" alt="<%= profileUser.name %>" class="h-full w-full object-cover">
        <% } else { %>
          <%= initials %>
        <% } %>
      </div>
      <h1 class="mt-5 text-3xl font-black tracking-tight text-slate-950 dark:text-white"><%= profileUser.name %></h1>
      <p class="mx-auto mt-3 max-w-sm text-sm leading-6 text-slate-600 dark:text-slate-300"><%= profileUser.bio %></p>

      <% if (profileUser.socialLinks.length) { %>
        <div class="mt-5 flex justify-center gap-2">
          <% profileUser.socialLinks.forEach((social) => { %>
            <a href="<%= social.url %>" target="_blank" rel="noopener noreferrer" aria-label="<%= social.label %>" class="premium-button flex h-10 w-10 items-center justify-center rounded-full bg-white/50 text-slate-600 backdrop-blur-md hover:text-slate-950 dark:bg-white/10 dark:text-slate-300 dark:hover:text-white">
              <i data-lucide="<%= social.icon || 'globe' %>" class="h-4 w-4"></i>
            </a>
          <% }) %>
        </div>
      <% } %>
    </section>

    <section class="mt-5 space-y-3">
      <% links.forEach((link) => { %>
        <% const unlocked = unlockedLinks.includes(link._id.toString()) || link.gate.type === 'none'; %>
        <% const animationClass = link.animation === 'leap' ? 'link-leap' : link.animation === 'pulse' ? 'link-pulse' : link.animation === 'float' ? 'link-float' : ''; %>
        <a href="/<%= profileUser.username %>/links/<%= link._id %>" class="premium-button <%= buttonClass %> <%= animationClass %> group flex items-center gap-4 rounded-[1.65rem] border border-white/40 p-4 backdrop-blur-xl dark:border-white/10">
          <span class="flex h-12 w-12 shrink-0 items-center justify-center overflow-hidden rounded-2xl bg-white/40 dark:bg-white/10">
            <% if (link.thumbnailUrl) { %>
              <img src="<%= link.thumbnailUrl %>" alt="" class="h-full w-full object-cover">
            <% } else { %>
              <i data-lucide="<%= link.icon || 'link' %>" class="h-5 w-5"></i>
            <% } %>
          </span>
          <span class="min-w-0 flex-1 text-left <%= profileUser.locale === 'ar' ? 'text-right' : '' %>">
            <span class="block truncate font-black"><%= link.title %></span>
            <% if (link.description) { %>
              <span class="mt-1 block truncate text-xs opacity-70"><%= link.description %></span>
            <% } %>
          </span>
          <% if (!unlocked) { %>
            <i data-lucide="lock" class="h-5 w-5 opacity-55"></i>
          <% } else if (link.type === 'product') { %>
            <span class="rounded-full bg-black/10 px-3 py-1 text-xs font-black dark:bg-white/10"><%= link.commerce.currency %> <%= link.commerce.price %></span>
          <% } else { %>
            <i data-lucide="arrow-up-right" class="h-5 w-5 transition-premium group-hover:translate-x-0.5 group-hover:-translate-y-0.5"></i>
          <% } %>
        </a>
      <% }) %>
    </section>

    <% if (profileUser.tipJar.enabled) { %>
      <section id="support" class="glass-card mt-5 rounded-[2rem] p-5">
        <div class="flex items-center gap-3">
          <span class="flex h-11 w-11 items-center justify-center rounded-2xl bg-rose-500/10 text-rose-500"><i data-lucide="heart" class="h-5 w-5"></i></span>
          <div>
            <h2 class="font-black"><%= profileUser.tipJar.headline || t('supportMe') %></h2>
            <p class="text-xs text-slate-500 dark:text-slate-400">Tip jar simulation with analytics tracking.</p>
          </div>
        </div>
        <form action="/<%= profileUser.username %>/tip" method="post" class="mt-4 grid grid-cols-3 gap-2">
          <% profileUser.tipJar.suggestedAmounts.forEach((amount) => { %>
            <button name="amount" value="<%= amount %>" class="premium-button rounded-2xl bg-slate-950 px-3 py-3 text-sm font-black text-white dark:bg-white dark:text-black">
              <%= profileUser.tipJar.currency %> <%= amount %>
            </button>
          <% }) %>
        </form>
      </section>
    <% } %>

    <% if (profileUser.products.length) { %>
      <section class="glass-card mt-5 rounded-[2rem] p-5">
        <h2 class="mb-4 flex items-center gap-2 font-black"><i data-lucide="shopping-bag" class="h-5 w-5"></i> Digital shelf</h2>
        <div class="space-y-3">
          <% profileUser.products.filter((product) => product.active).forEach((product) => { %>
            <div class="rounded-3xl bg-white/55 p-4 dark:bg-white/5">
              <p class="font-black"><%= product.title %></p>
              <p class="mt-1 text-sm text-slate-600 dark:text-slate-300"><%= product.description %></p>
              <div class="mt-3 flex items-center justify-between">
                <span class="text-sm font-black"><%= product.currency %> <%= product.price %></span>
                <span class="rounded-full bg-slate-950 px-3 py-1 text-xs font-black text-white dark:bg-white dark:text-black"><%= product.fileLabel %></span>
              </div>
            </div>
          <% }) %>
        </div>
      </section>
    <% } %>

    <footer class="pb-24 pt-8 text-center text-xs font-bold text-slate-500 dark:text-slate-400">
      Powered by <%= t('brand') %>
    </footer>
  </div>

  <% if (gateLink) { %>
    <button class="hidden" data-open-on-load="gate" data-target="#gate-modal"></button>
    <div id="gate-modal" class="modal fixed inset-0 z-50 grid place-items-end bg-black/35 p-4 backdrop-blur-sm sm:place-items-center">
      <div class="w-full max-w-md rounded-[2rem] bg-white p-6 shadow-premium dark:bg-zinc-950">
        <div class="flex items-center justify-between">
          <h2 id="gate" class="text-2xl font-black"><%= t('unlock') %> <%= gateLink.title %></h2>
          <button data-modal-close type="button" class="rounded-full p-2 hover:bg-slate-100 dark:hover:bg-white/10"><i data-lucide="x" class="h-5 w-5"></i></button>
        </div>
        <form action="/<%= profileUser.username %>/links/<%= gateLink._id %>/unlock" method="post" class="mt-5 space-y-4">
          <% if (gateLink.gate.type === 'password') { %>
            <input name="password" type="password" placeholder="Password" required class="w-full rounded-2xl border border-slate-200 bg-white px-4 py-3 outline-none dark:border-white/10 dark:bg-black">
          <% } %>
          <% if (gateLink.gate.type === 'age') { %>
            <label class="flex items-center gap-3 rounded-2xl bg-slate-100 p-4 font-bold dark:bg-white/10"><input name="ageConfirm" type="checkbox" required> I confirm I am <%= gateLink.gate.ageMinimum %> or older.</label>
          <% } %>
          <% if (gateLink.gate.type === 'newsletter') { %>
            <p class="text-sm text-slate-600 dark:text-slate-300"><%= gateLink.gate.newsletterLabel %></p>
            <input name="email" type="email" placeholder="you@example.com" required class="w-full rounded-2xl border border-slate-200 bg-white px-4 py-3 outline-none dark:border-white/10 dark:bg-black">
          <% } %>
          <button class="premium-button w-full rounded-2xl bg-slate-950 px-5 py-4 font-black text-white dark:bg-white dark:text-black"><%= t('unlock') %></button>
        </form>
      </div>
    </div>
  <% } %>

  <% if (checkoutLink) { %>
    <button class="hidden" data-open-on-load="checkout" data-target="#checkout-modal"></button>
    <div id="checkout-modal" class="modal fixed inset-0 z-50 grid place-items-end bg-black/35 p-4 backdrop-blur-sm sm:place-items-center">
      <div class="w-full max-w-md rounded-[2rem] bg-white p-6 shadow-premium dark:bg-zinc-950">
        <div class="flex items-center justify-between">
          <h2 id="checkout" class="text-2xl font-black"><%= t('checkout') %></h2>
          <button data-modal-close type="button" class="rounded-full p-2 hover:bg-slate-100 dark:hover:bg-white/10"><i data-lucide="x" class="h-5 w-5"></i></button>
        </div>
        <div class="mt-5 rounded-3xl bg-slate-100 p-5 dark:bg-white/10">
          <p class="text-sm font-bold uppercase tracking-[0.2em] text-slate-500 dark:text-slate-400"><%= checkoutLink.commerce.productLabel %></p>
          <p class="mt-2 text-xl font-black"><%= checkoutLink.title %></p>
          <p class="mt-2 text-sm text-slate-600 dark:text-slate-300"><%= checkoutLink.description %></p>
          <p class="mt-4 text-3xl font-black"><%= checkoutLink.commerce.currency %> <%= checkoutLink.commerce.price %></p>
        </div>
        <form action="/<%= profileUser.username %>/checkout/<%= checkoutLink._id %>" method="post" class="mt-5 space-y-3">
          <input placeholder="Card number (simulation)" value="4242 4242 4242 4242" class="w-full rounded-2xl border border-slate-200 bg-white px-4 py-3 outline-none dark:border-white/10 dark:bg-black">
          <div class="grid grid-cols-2 gap-3">
            <input placeholder="MM/YY" value="12/30" class="rounded-2xl border border-slate-200 bg-white px-4 py-3 outline-none dark:border-white/10 dark:bg-black">
            <input placeholder="CVC" value="123" class="rounded-2xl border border-slate-200 bg-white px-4 py-3 outline-none dark:border-white/10 dark:bg-black">
          </div>
          <button class="premium-button w-full rounded-2xl bg-slate-950 px-5 py-4 font-black text-white dark:bg-white dark:text-black">Complete simulated checkout</button>
        </form>
      </div>
    </div>
  <% } %>
</main>
<%- include('partials/controls', { locales, locale: profileUser.locale || locale, isRtl: (profileUser.locale || locale) === 'ar', t }) %>
<%- include('partials/footer-scripts') %>
