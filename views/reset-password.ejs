<%- include('partials/head', { title, locale, isRtl, t, locales, flash }) %>
<main class="grid min-h-screen place-items-center px-6 py-12">
  <section class="w-full max-w-md">
    <%- include('partials/flash', { flash }) %>
    <div class="glass-card rounded-[2rem] p-8">
      <h1 class="text-3xl font-black tracking-tight">Choose a new password</h1>
      <p class="mt-3 text-sm leading-6 text-slate-600 dark:text-slate-300">Use at least 8 characters.</p>
      <form action="/auth/reset-password/<%= token %>" method="post" class="mt-8 space-y-4">
        <label class="block">
          <span class="text-sm font-bold">New password</span>
          <input name="password" type="password" required minlength="8" class="mt-2 w-full rounded-2xl border border-slate-200 bg-white/80 px-4 py-3 outline-none transition-premium focus:border-blue-500 focus:ring-4 focus:ring-blue-500/10 dark:border-white/10 dark:bg-zinc-950">
        </label>
        <button class="premium-button w-full rounded-2xl bg-slate-950 px-5 py-4 font-black text-white shadow-premium dark:bg-white dark:text-black">Update password</button>
      </form>
    </div>
  </section>
</main>
<%- include('partials/controls', { locales, locale, isRtl, t }) %>
<%- include('partials/footer-scripts') %>
