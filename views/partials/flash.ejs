<% if (flash) { %>
  <div class="mx-auto mb-6 max-w-5xl rounded-3xl border px-5 py-4 text-sm font-semibold shadow-premium backdrop-blur-xl <%= flash.type === 'error' ? 'border-rose-200 bg-rose-50/90 text-rose-700 dark:border-rose-500/30 dark:bg-rose-950/50 dark:text-rose-200' : flash.type === 'success' ? 'border-emerald-200 bg-emerald-50/90 text-emerald-700 dark:border-emerald-500/30 dark:bg-emerald-950/50 dark:text-emerald-200' : 'border-blue-200 bg-blue-50/90 text-blue-700 dark:border-blue-500/30 dark:bg-blue-950/50 dark:text-blue-200' %>">
    <%= flash.message %>
  </div>
<% } %>
