<%- include('partials/head', { title, locale, isRtl, t, locales, flash }) %>
<main class="grid min-h-screen place-items-center px-6 py-12">
  <section class="glass-card max-w-lg rounded-[2.25rem] p-8 text-center">
    <div class="mx-auto flex h-16 w-16 items-center justify-center rounded-3xl bg-rose-500/10 text-rose-500">
      <i data-lucide="orbit" class="h-7 w-7"></i>
    </div>
    <h1 class="mt-6 text-4xl font-black tracking-tight"><%= title %></h1>
    <p class="mt-4 leading-7 text-slate-600 dark:text-slate-300"><%= message %></p>
    <div class="mt-8 flex justify-center gap-3">
      <a href="/" class="premium-button rounded-full bg-slate-950 px-6 py-3 text-sm font-black text-white dark:bg-white dark:text-black">Go home</a>
      <% if (currentUser) { %>
        <a href="/admin" class="premium-button rounded-full border border-slate-200 bg-white/70 px-6 py-3 text-sm font-black dark:border-white/10 dark:bg-white/10">Dashboard</a>
      <% } %>
    </div>
  </section>
</main>
<%- include('partials/controls', { locales, locale, isRtl, t }) %>
<%- include('partials/footer-scripts') %>
