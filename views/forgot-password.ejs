<%- include('partials/head', { title, locale, isRtl, t, locales, flash }) %>
<main class="grid min-h-screen place-items-center px-6 py-12">
  <section class="w-full max-w-md">
    <a href="/" class="mx-auto mb-8 flex w-max items-center gap-3 text-lg font-black">
      <span class="flex h-11 w-11 items-center justify-center rounded-2xl bg-black text-white dark:bg-white dark:text-black"><i data-lucide="key-round" class="h-5 w-5"></i></span>
      <%= t('brand') %>
    </a>
    <%- include('partials/flash', { flash }) %>
    <div class="glass-card rounded-[2rem] p-8">
      <h1 class="text-3xl font-black tracking-tight">Reset password</h1>
      <p class="mt-3 text-sm leading-6 text-slate-600 dark:text-slate-300">Enter your email. In this local app, a secure reset URL is generated below instead of sending email.</p>
      <form action="/auth/forgot-password" method="post" class="mt-8 space-y-4">
        <label class="block">
          <span class="text-sm font-bold">Email</span>
          <input name="email" type="email" required class="mt-2 w-full rounded-2xl border border-slate-200 bg-white/80 px-4 py-3 outline-none transition-premium focus:border-blue-500 focus:ring-4 focus:ring-blue-500/10 dark:border-white/10 dark:bg-zinc-950">
        </label>
        <button class="premium-button w-full rounded-2xl bg-slate-950 px-5 py-4 font-black text-white shadow-premium dark:bg-white dark:text-black">Generate reset link</button>
      </form>
      <% if (resetUrl) { %>
        <div class="mt-6 rounded-2xl border border-blue-200 bg-blue-50 p-4 text-sm dark:border-blue-500/30 dark:bg-blue-950/40">
          <p class="font-black text-blue-700 dark:text-blue-200">Reset URL</p>
          <a href="<%= resetUrl %>" class="mt-2 block break-all text-blue-600 underline dark:text-blue-300"><%= resetUrl %></a>
        </div>
      <% } %>
      <a href="/auth/login" class="mt-6 block text-center text-sm font-bold text-slate-600 hover:text-slate-950 dark:text-slate-300 dark:hover:text-white">Back to login</a>
    </div>
  </section>
</main>
<%- include('partials/controls', { locales, locale, isRtl, t }) %>
<%- include('partials/footer-scripts') %>
