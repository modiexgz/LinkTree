<%- include('partials/head', { title, locale, isRtl, t, locales, flash }) %>
<main class="mx-auto flex min-h-screen w-full max-w-7xl flex-col px-6 py-8">
  <nav class="flex items-center justify-between">
    <a href="/" class="flex items-center gap-3 text-lg font-black tracking-tight">
      <span class="flex h-11 w-11 items-center justify-center rounded-2xl bg-black text-white shadow-premium dark:bg-white dark:text-black">
        <i data-lucide="sparkles" class="h-5 w-5"></i>
      </span>
      <%= t('brand') %>
    </a>
    <div class="flex items-center gap-3">
      <a href="/auth/login" class="rounded-full px-5 py-2.5 text-sm font-bold text-slate-700 transition-premium hover:bg-white/70 dark:text-slate-200 dark:hover:bg-white/10"><%= t('login') %></a>
      <a href="/auth/signup" class="premium-button rounded-full bg-slate-950 px-5 py-2.5 text-sm font-bold text-white shadow-premium dark:bg-white dark:text-black"><%= t('signup') %></a>
    </div>
  </nav>

  <section class="grid flex-1 items-center gap-12 py-16 lg:grid-cols-[1.05fr_0.95fr]">
    <div>
      <div class="mb-6 inline-flex items-center gap-2 rounded-full border border-white/60 bg-white/70 px-4 py-2 text-sm font-bold text-slate-700 shadow-sm backdrop-blur-xl dark:border-white/10 dark:bg-white/10 dark:text-slate-200">
        <span class="h-2 w-2 rounded-full bg-emerald-500"></span>
        Premium multi-tenant bio links
      </div>
      <h1 class="max-w-4xl text-5xl font-black leading-[0.95] tracking-tight text-slate-950 dark:text-white sm:text-7xl">
        A polished creator storefront that feels native, fluid, and alive.
      </h1>
      <p class="mt-7 max-w-2xl text-lg leading-8 text-slate-600 dark:text-slate-300">
        Launch a SaaS-grade Linktree clone with analytics, gated links, scheduling, tip jars, product checkout simulation, global languages, and deeply customizable profiles.
      </p>
      <div class="mt-9 flex flex-wrap gap-4">
        <a href="/auth/signup" class="premium-button inline-flex items-center gap-2 rounded-full bg-slate-950 px-7 py-4 text-sm font-black text-white shadow-premium dark:bg-white dark:text-black">
          Start building <i data-lucide="arrow-right" class="h-4 w-4"></i>
        </a>
        <a href="/auth/login" class="premium-button inline-flex items-center gap-2 rounded-full border border-slate-200 bg-white/70 px-7 py-4 text-sm font-black text-slate-900 backdrop-blur-xl dark:border-white/10 dark:bg-white/10 dark:text-white">
          View dashboard <i data-lucide="layout-dashboard" class="h-4 w-4"></i>
        </a>
      </div>
    </div>

    <div class="relative mx-auto w-full max-w-md">
      <div class="absolute -inset-6 rounded-[3rem] bg-gradient-to-br from-blue-500/20 via-fuchsia-500/20 to-amber-300/20 blur-3xl"></div>
      <div data-tilt class="glass-card relative overflow-hidden rounded-[2.5rem] p-5">
        <div class="rounded-[2rem] bg-gradient-to-br from-slate-950 via-zinc-900 to-black p-6 text-white shadow-obsidian">
          <div class="flex items-center justify-between">
            <div class="flex items-center gap-3">
              <div class="h-14 w-14 rounded-full bg-gradient-to-br from-blue-300 to-fuchsia-300"></div>
              <div>
                <p class="font-black">@lumin.studio</p>
                <p class="text-sm text-white/55">Design systems, drops, commerce.</p>
              </div>
            </div>
            <i data-lucide="verified" class="h-6 w-6 text-blue-300"></i>
          </div>
          <div class="mt-8 space-y-3">
            <% ['Latest launch', 'Join the private newsletter', 'Buy the creator kit'].forEach((label, index) => { %>
              <div class="premium-button flex items-center justify-between rounded-3xl border border-white/10 bg-white/10 p-4 backdrop-blur-md <%= index === 0 ? 'link-leap' : '' %>">
                <span class="flex items-center gap-3 text-sm font-bold">
                  <i data-lucide="<%= index === 2 ? 'shopping-bag' : index === 1 ? 'mail' : 'sparkles' %>" class="h-4 w-4"></i>
                  <%= label %>
                </span>
                <i data-lucide="arrow-up-right" class="h-4 w-4"></i>
              </div>
            <% }) %>
          </div>
          <div class="mt-8 grid grid-cols-3 gap-3 text-center">
            <div class="rounded-2xl bg-white/10 p-3">
              <p class="text-xl font-black">42k</p>
              <p class="text-xs text-white/50">views</p>
            </div>
            <div class="rounded-2xl bg-white/10 p-3">
              <p class="text-xl font-black">18%</p>
              <p class="text-xs text-white/50">CTR</p>
            </div>
            <div class="rounded-2xl bg-white/10 p-3">
              <p class="text-xl font-black">6</p>
              <p class="text-xs text-white/50">langs</p>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>
</main>
<%- include('partials/controls', { locales, locale, isRtl, t }) %>
<%- include('partials/footer-scripts') %>
