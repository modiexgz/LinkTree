<%- include('partials/head', { title, locale, isRtl, t, locales, flash }) %>
<main class="mx-auto w-full max-w-7xl px-6 py-8">
  <%- include('partials/marketing-nav', { t }) %>

  <section class="grid min-h-[82vh] items-center gap-12 py-16 lg:grid-cols-[1.05fr_0.95fr]">
    <div>
      <div class="mb-6 inline-flex items-center gap-2 rounded-full border border-emerald-200 bg-emerald-50/80 px-4 py-2 text-sm font-black text-emerald-700 shadow-sm backdrop-blur-xl dark:border-emerald-500/20 dark:bg-emerald-500/10 dark:text-emerald-200">
        <span class="h-2 w-2 rounded-full bg-emerald-500"></span>
        Bio link, storefront, analytics, and audience tools in one place
      </div>
      <h1 class="max-w-5xl text-5xl font-black leading-[0.92] tracking-tight text-slate-950 dark:text-white sm:text-7xl lg:text-8xl">
        Everything you are, in one beautiful link.
      </h1>
      <p class="mt-7 max-w-2xl text-lg leading-8 text-slate-600 dark:text-slate-300">
        Share every link, product, drop, social channel, newsletter, and offer from a single customizable page. Build it in minutes, publish it everywhere, and learn what your audience clicks.
      </p>
      <form action="/auth/signup" method="get" class="mt-8 flex max-w-xl flex-col gap-3 rounded-[2rem] border border-white/60 bg-white/75 p-2 shadow-premium backdrop-blur-xl dark:border-white/10 dark:bg-zinc-950/70 sm:flex-row">
        <div class="flex flex-1 items-center gap-2 rounded-[1.35rem] bg-slate-100 px-4 py-3 dark:bg-white/10">
          <span class="text-sm font-black text-slate-500 dark:text-slate-400">lumin.bio/</span>
          <input aria-label="Choose username" placeholder="yourname" class="w-full bg-transparent text-sm font-black outline-none placeholder:text-slate-400">
        </div>
        <button class="premium-button rounded-[1.35rem] bg-slate-950 px-6 py-3 text-sm font-black text-white dark:bg-white dark:text-black">Claim your link</button>
      </form>
      <div class="mt-7 flex flex-wrap gap-3 text-sm font-bold text-slate-500 dark:text-slate-400">
        <span class="rounded-full bg-white/70 px-4 py-2 dark:bg-white/10">No code</span>
        <span class="rounded-full bg-white/70 px-4 py-2 dark:bg-white/10">Dark mode</span>
        <span class="rounded-full bg-white/70 px-4 py-2 dark:bg-white/10">Global languages</span>
        <span class="rounded-full bg-white/70 px-4 py-2 dark:bg-white/10">Creator commerce</span>
      </div>
    </div>

    <div class="relative mx-auto w-full max-w-md">
      <div class="absolute -inset-8 rounded-[3rem] bg-gradient-to-br from-lime-300/35 via-blue-500/20 to-fuchsia-500/25 blur-3xl"></div>
      <div data-tilt class="glass-card relative overflow-hidden rounded-[2.75rem] p-5">
        <div class="rounded-[2.15rem] bg-gradient-to-br from-slate-950 via-zinc-900 to-black p-6 text-white shadow-obsidian">
          <div class="flex items-center justify-between">
            <div class="flex items-center gap-3">
              <div class="grid h-16 w-16 place-items-center rounded-full bg-gradient-to-br from-lime-200 via-blue-300 to-fuchsia-300 text-xl font-black text-slate-950">LB</div>
              <div>
                <p class="font-black">@lumin.creator</p>
                <p class="text-sm text-white/55">Links, drops, classes, merch.</p>
              </div>
            </div>
            <i data-lucide="verified" class="h-6 w-6 text-blue-300"></i>
          </div>
          <div class="mt-8 space-y-3">
            <% [
              { label: 'Watch my newest video', icon: 'play-circle', tag: 'Featured' },
              { label: 'Shop the digital creator kit', icon: 'shopping-bag', tag: '$29' },
              { label: 'Join the private newsletter', icon: 'mail', tag: 'Unlock' },
              { label: 'Book a brand collaboration', icon: 'calendar-check', tag: 'Open' }
            ].forEach((item, index) => { %>
              <div class="premium-button flex items-center justify-between rounded-3xl border border-white/10 bg-white/10 p-4 backdrop-blur-md <%= index === 0 ? 'link-leap' : '' %>">
                <span class="flex items-center gap-3 text-sm font-bold">
                  <i data-lucide="<%= item.icon %>" class="h-4 w-4"></i>
                  <%= item.label %>
                </span>
                <span class="rounded-full bg-white/10 px-2.5 py-1 text-[11px] font-black text-white/70"><%= item.tag %></span>
              </div>
            <% }) %>
          </div>
          <div class="mt-8 grid grid-cols-3 gap-3 text-center">
            <div class="rounded-2xl bg-white/10 p-3">
              <p class="text-xl font-black">42k</p>
              <p class="text-xs text-white/50">views</p>
            </div>
            <div class="rounded-2xl bg-white/10 p-3">
              <p class="text-xl font-black">18%</p>
              <p class="text-xs text-white/50">CTR</p>
            </div>
            <div class="rounded-2xl bg-white/10 p-3">
              <p class="text-xl font-black">$2.4k</p>
              <p class="text-xs text-white/50">sales</p>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <section id="create" class="py-12">
    <div class="mb-8 max-w-3xl">
      <p class="mb-3 text-sm font-black uppercase tracking-[0.24em] text-blue-600 dark:text-blue-300">What you can do</p>
      <h2 class="text-4xl font-black tracking-tight sm:text-6xl">Create, share, sell, and grow from one simple bio page.</h2>
    </div>
    <div class="grid gap-5 md:grid-cols-2 lg:grid-cols-4">
      <% [
        { icon: 'palette', title: 'Create and customize', body: 'Choose themes, typography, button styles, images, video backgrounds, social icons, and language direction.' },
        { icon: 'share-2', title: 'Share anywhere', body: 'Use one memorable bio URL across Instagram, TikTok, YouTube, email signatures, QR codes, and campaigns.' },
        { icon: 'bar-chart-3', title: 'Analyze every click', body: 'See profile views, unique visitors, click-through rate, top links, countries, and referrers.' },
        { icon: 'badge-dollar-sign', title: 'Sell and collect support', body: 'Add product cards, checkout overlays, gated links, newsletter unlocks, and a tip jar.' }
      ].forEach((feature) => { %>
        <article class="glass-card premium-button rounded-[2rem] p-6">
          <span class="mb-5 flex h-12 w-12 items-center justify-center rounded-2xl bg-slate-950 text-white dark:bg-white dark:text-black"><i data-lucide="<%= feature.icon %>" class="h-5 w-5"></i></span>
          <h3 class="text-xl font-black"><%= feature.title %></h3>
          <p class="mt-3 text-sm leading-6 text-slate-600 dark:text-slate-300"><%= feature.body %></p>
        </article>
      <% }) %>
    </div>
  </section>

  <section id="sell" class="grid items-center gap-8 py-12 lg:grid-cols-2">
    <div class="rounded-[2.5rem] bg-lime-200 p-8 text-slate-950 shadow-premium dark:bg-lime-300">
      <p class="text-sm font-black uppercase tracking-[0.24em] text-slate-700">Monetize faster</p>
      <h2 class="mt-4 text-4xl font-black leading-tight tracking-tight sm:text-6xl">Turn followers into customers without sending them through a maze.</h2>
      <p class="mt-5 max-w-xl text-lg leading-8 text-slate-700">Highlight products, collect tips, gate exclusive content, and send visitors to exactly the next action you want them to take.</p>
      <a href="/auth/signup" class="premium-button mt-8 inline-flex items-center gap-2 rounded-full bg-slate-950 px-7 py-4 text-sm font-black text-white">Start selling <i data-lucide="arrow-right" class="h-4 w-4"></i></a>
    </div>
    <div class="space-y-4">
      <% [
        ['Product checkout simulation', 'Show a premium purchase flow directly from the bio profile.'],
        ['Support Me tip jar', 'Let visitors send quick support amounts with analytics tracking.'],
        ['Gated content unlocks', 'Require a password, age confirmation, or newsletter signup before a link opens.']
      ].forEach((item, index) => { %>
        <div class="glass-card rounded-[2rem] p-5">
          <div class="flex items-start gap-4">
            <span class="grid h-10 w-10 shrink-0 place-items-center rounded-full bg-slate-950 text-sm font-black text-white dark:bg-white dark:text-black">0<%= index + 1 %></span>
            <div>
              <h3 class="font-black"><%= item[0] %></h3>
              <p class="mt-1 text-sm leading-6 text-slate-600 dark:text-slate-300"><%= item[1] %></p>
            </div>
          </div>
        </div>
      <% }) %>
    </div>
  </section>

  <section id="analytics" class="py-12">
    <div class="glass-card grid gap-8 rounded-[2.5rem] p-8 lg:grid-cols-[0.9fr_1.1fr]">
      <div>
        <p class="mb-3 text-sm font-black uppercase tracking-[0.24em] text-fuchsia-600 dark:text-fuchsia-300">Know what works</p>
        <h2 class="text-4xl font-black tracking-tight sm:text-5xl">Update your bio based on real visitor behavior.</h2>
        <p class="mt-5 text-slate-600 dark:text-slate-300">Spot which links convert, where your traffic comes from, and how visitors move through your profile so you can keep your best content first.</p>
      </div>
      <div class="rounded-[2rem] border border-slate-200 bg-white/70 p-5 dark:border-white/10 dark:bg-black/30">
        <div class="grid grid-cols-3 gap-3">
          <div class="rounded-2xl bg-slate-950 p-4 text-white dark:bg-white dark:text-black"><p class="text-2xl font-black">12.8k</p><p class="text-xs font-bold opacity-60">Views</p></div>
          <div class="rounded-2xl bg-blue-500 p-4 text-white"><p class="text-2xl font-black">4.1k</p><p class="text-xs font-bold opacity-70">Clicks</p></div>
          <div class="rounded-2xl bg-fuchsia-500 p-4 text-white"><p class="text-2xl font-black">32%</p><p class="text-xs font-bold opacity-70">CTR</p></div>
        </div>
        <div class="mt-4 space-y-3">
          <% ['YouTube launch', 'Preset pack', 'Newsletter unlock'].forEach((label, index) => { %>
            <div class="flex items-center justify-between rounded-2xl bg-slate-100 p-4 dark:bg-white/10">
              <span class="font-black"><%= label %></span>
              <span class="text-sm font-black text-slate-500 dark:text-slate-300"><%= [1820, 911, 604][index] %> clicks</span>
            </div>
          <% }) %>
        </div>
      </div>
    </div>
  </section>

  <section class="grid gap-6 py-12 lg:grid-cols-3">
    <a href="/templates" class="glass-card premium-button rounded-[2.25rem] p-6">
      <span class="grid h-12 w-12 place-items-center rounded-2xl bg-fuchsia-500 text-white"><i data-lucide="layout-template" class="h-5 w-5"></i></span>
      <h2 class="mt-5 text-3xl font-black">Template library</h2>
      <p class="mt-3 text-sm leading-6 text-slate-600 dark:text-slate-300">Start from creator, storefront, coach, music, local business, and portfolio templates.</p>
    </a>
    <a href="/marketplace" class="glass-card premium-button rounded-[2.25rem] p-6">
      <span class="grid h-12 w-12 place-items-center rounded-2xl bg-emerald-500 text-white"><i data-lucide="blocks" class="h-5 w-5"></i></span>
      <h2 class="mt-5 text-3xl font-black">Marketplace blocks</h2>
      <p class="mt-3 text-sm leading-6 text-slate-600 dark:text-slate-300">Connect content, commerce, payments, booking, audience, music, and analytics tools.</p>
    </a>
    <a href="/pricing" class="glass-card premium-button rounded-[2.25rem] p-6">
      <span class="grid h-12 w-12 place-items-center rounded-2xl bg-slate-950 text-white dark:bg-white dark:text-black"><i data-lucide="badge-dollar-sign" class="h-5 w-5"></i></span>
      <h2 class="mt-5 text-3xl font-black">Business pricing</h2>
      <p class="mt-3 text-sm leading-6 text-slate-600 dark:text-slate-300">Free to start, then paid plans for monetization, analytics, customization, and teams.</p>
    </a>
  </section>

  <section class="py-12 text-center">
    <p class="mb-5 text-sm font-black uppercase tracking-[0.24em] text-slate-500 dark:text-slate-400">Built for every creator type</p>
    <div class="mx-auto flex max-w-5xl flex-wrap justify-center gap-3">
      <% ['creators', 'influencers', 'small businesses', 'musicians', 'podcasters', 'coaches', 'streamers', 'ecommerce sellers', 'writers', 'DJs', 'fitness coaches', 'designers'].forEach((role) => { %>
        <span class="premium-button rounded-full border border-slate-200 bg-white/70 px-5 py-3 text-sm font-black text-slate-700 backdrop-blur-xl dark:border-white/10 dark:bg-white/10 dark:text-slate-200"><%= role %></span>
      <% }) %>
    </div>
  </section>

  <section class="grid gap-5 py-12 md:grid-cols-3">
    <% [
      ['“I can put my launch, products, and newsletter in one clean place.”', 'Ari, digital creator'],
      ['“The dashboard makes it obvious which link should be first.”', 'Maya, coach'],
      ['“The profile feels premium enough to replace my old mini-site.”', 'Noah, musician']
    ].forEach((quote) => { %>
      <blockquote class="glass-card rounded-[2rem] p-6">
        <p class="text-lg font-black leading-7"><%= quote[0] %></p>
        <footer class="mt-5 text-sm font-bold text-slate-500 dark:text-slate-400"><%= quote[1] %></footer>
      </blockquote>
    <% }) %>
  </section>

  <section class="grid gap-8 py-12 lg:grid-cols-[0.8fr_1.2fr]">
    <div>
      <p class="mb-3 text-sm font-black uppercase tracking-[0.24em] text-blue-600 dark:text-blue-300">Questions? Answered</p>
      <h2 class="text-4xl font-black tracking-tight">Everything visitors need to understand the product.</h2>
    </div>
    <div class="space-y-3">
      <% [
        ['Do I need a website?', 'No. Your bio profile acts like a focused mini-site for links, offers, products, and social channels.'],
        ['Can I sell from it?', 'Yes. Add product-style links, tip jar support, and a checkout overlay simulation for digital products.'],
        ['Can I control what visitors see?', 'Yes. Schedule links, pin important links, animate priority actions, and gate exclusive content.'],
        ['Does it support global audiences?', 'Yes. It includes English, Arabic with RTL layout, Swahili, French, Amharic, and Tigrigna.']
      ].forEach((faq) => { %>
        <details class="glass-card rounded-[1.5rem] p-5">
          <summary class="cursor-pointer list-none font-black"><%= faq[0] %></summary>
          <p class="mt-3 text-sm leading-6 text-slate-600 dark:text-slate-300"><%= faq[1] %></p>
        </details>
      <% }) %>
    </div>
  </section>

  <section class="my-12 overflow-hidden rounded-[2.5rem] bg-slate-950 p-8 text-center text-white shadow-obsidian dark:bg-white dark:text-black">
    <h2 class="mx-auto max-w-3xl text-4xl font-black tracking-tight sm:text-6xl">Jumpstart your corner of the internet today.</h2>
    <p class="mx-auto mt-5 max-w-2xl text-white/60 dark:text-black/60">Create a beautiful bio link, publish your best content, sell your work, and understand your audience from one premium dashboard.</p>
    <a href="/auth/signup" class="premium-button mt-8 inline-flex items-center gap-2 rounded-full bg-white px-7 py-4 text-sm font-black text-black dark:bg-black dark:text-white">Get started free <i data-lucide="arrow-right" class="h-4 w-4"></i></a>
  </section>
</main>
<%- include('partials/controls', { locales, locale, isRtl, t }) %>
<%- include('partials/footer-scripts') %>
